<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="../red/subred4.net.xml"/>
        <route-files value="../demanda/normal.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
